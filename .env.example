# ────────────────────────────────────────────────────────────
# JerSuit V2 — Environment Configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. `.env*.local` is git-ignored.
# ────────────────────────────────────────────────────────────

# ── Discord OAuth2 (Dashboard login) ────────────────────────
# Application ID from the Discord Developer Portal
DISCORD_CLIENT_ID=1535389014507524167
# Client ID exposed to the browser (used for the "Add to server" invite URL).
# This is the same value as DISCORD_CLIENT_ID. It is NOT a secret.
NEXT_PUBLIC_DISCORD_CLIENT_ID=1535389014507524167
# Application "Client Secret"
DISCORD_CLIENT_SECRET=qOG_sgL2LEaBLwS6jQZW7l5dHJ_TCDDa
# Must end in /api/auth/callback
DISCORD_REDIRECT_URI=https://probable-space-chainsaw-p7gq9jgvwrqwf77r7-3000.app.github.dev/api/auth/callback
# ── Discord Bot (optional, enables the real bot process) ───
# Bot token from the Discord Developer Portal ("Bot" section).
# Leave empty to run the dashboard without a connected bot.
DISCORD_BOT_TOKEN=MTUzNTM4OTAxNDUwNzUyNDE2Nw.GY5soe.1HecFH4_NRZIQjK-gs-5El8aKO0azCC6JvfTI0

# ── Sessions ────────────────────────────────────────────────
# At least 16 characters. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=aa9cb903db7803725129cd9998c7ffaf3f2f1a117b56d42928964a76f450aed3

# ── Owner Control Center credentials ────────────────────────
# Username for admin-panel login.
JERSUIT_ADMIN_USERNAME=
# SHA-256 hex hash of the admin password. Generate with:
#   node -e "require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex')"
JERSUIT_ADMIN_PASSWORD_HASH=

# Discord ID of the platform owner (user flagged is_platform_owner / can manage everything).
# Optional. Leave empty if not used.
PLATFORM_OWNER_DISCORD_ID=

# ── Application URL ──────────────────────────────────────────
# Public base URL of this deployment (used for canonical redirects so that a
# login in Codespaces/behind a proxy redirects back to the same host instead
# of localhost). Example: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Public Discord Application ID (safe to expose). Used by the client to build
# the "Add bot to server" invite link.
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# ── Embedded database (optional) ─────────────────────────────
# Directory where the internal PGlite database persists.
# Defaults to `./.data/jersuit-v2` relative to the project root.
PGLITE_DATA_DIR=
