export const dynamic = 'force-dynamic';
import { NextResponse } from 'next/server';
import { getUserGuilds } from '@/lib/services';
import { cookies } from 'next/headers';
import { SESSION_COOKIE } from '@/lib/constants';


/**
 * Returns the guild IDs where the JerSuit bot is currently installed.
 *
 * This runs server-side. The bot token is NEVER exposed to the browser.
 */
async function getInstalledGuildIds(): Promise<Set<string>> {
  const token = process.env.DISCORD_BOT_TOKEN;

  if (!token) {
    console.warn('[guilds] DISCORD_BOT_TOKEN is not configured');
    return new Set();
  }

  try {
    const response = await fetch(
      'https://discord.com/api/v10/users/@me/guilds',
      {
        headers: {
          Authorization: `Bot ${token}`,
        },
        cache: 'no-store',
      }
    );

    if (!response.ok) {
      console.error(
        '[guilds] Discord bot guild lookup failed:',
        response.status
      );
      return new Set();
    }

    const guilds = await response.json();

  const installedGuildIds = await getInstalledGuildIds();

    if (!Array.isArray(guilds)) {
      return new Set();
    }

    return new Set(
      guilds
        .map((guild: { id?: string }) => guild.id)
        .filter((id): id is string => Boolean(id))
    );
  } catch (error) {
    console.error('[guilds] Discord bot guild lookup error:', error);
    return new Set();
  }
}


export async function GET() {
  const cookieStore = cookies();
  const token = cookieStore.get(SESSION_COOKIE)?.value;
  if (!token) {
    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
  }

  const guilds = await getUserGuilds(token);
  return NextResponse.json({ guilds });
}
